using Gtk 4.0;
using Adw 1;
using GtkSource 5;

template $QueryTab: Adw.Bin {
  child: Paned editor_paned {
    orientation: vertical;
    wide-handle: true;
    resize-start-child: true;
    resize-end-child: true;
    position: 400;

    start-child: ScrolledWindow {
      hexpand: true;
      vexpand: true;
      min-content-height: 120;

      child: GtkSource.View editor {
        hexpand: true;
        vexpand: true;
        monospace: true;
        auto-indent: true;
        smart-backspace: true;
        highlight-current-line: true;
        show-line-numbers: true;
        show-right-margin: true;
        right-margin-position: 100;
        tab-width: 2;
        insert-spaces-instead-of-tabs: true;
      };
    };

    end-child: Adw.ToastOverlay toast_overlay {
      child: Stack results_stack {
        hexpand: true;
        vexpand: true;
        transition-type: crossfade;

        StackPage {
          name: "results";
          child: $ResultsGrid results_grid {
            hexpand: true;
            vexpand: true;
          };
        }

        StackPage {
          name: "messages";
          child: ScrolledWindow {
            child: TextView messages_view {
              editable: false;
              monospace: true;
              wrap-mode: word_char;
            };
          };
        }
      };
    };
  };
}