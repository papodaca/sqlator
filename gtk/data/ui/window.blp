using Gtk 4.0;
using Adw 1;

template $SqlatorWindow: Adw.ApplicationWindow {
  default-width: 1280;
  default-height: 800;
  title: _("SQLator");

  Adw.Breakpoint {
    condition ("max-width: 800sp")

    setters {
      split_view.collapsed: true;
      tab_bar.visible: false;
      overview_button.visible: true;
    }
  }

  content: Adw.TabOverview tab_overview {
    view: tab_view;
    enable-new-tab: true;

    child: Adw.ToolbarView {
      top-bar-style: raised;

      [top]
      Adw.HeaderBar {
        [start]
        Button {
          action-name: "win.toggle-sidebar";
          icon-name: "sidebar-show-symbolic";
          tooltip-text: _("Toggle Sidebar");
        }

        [start]
        Button {
          action-name: "tab.run";
          icon-name: "media-playback-start-symbolic";
          tooltip-text: _("Run Query");
        }

        [start]
        Button {
          action-name: "tab.cancel";
          icon-name: "media-playback-stop-symbolic";
          tooltip-text: _("Cancel Query");
        }

        [end]
        Button overview_button {
          visible: false;
          action-name: "win.tab-overview";
          icon-name: "view-grid-symbolic";
          tooltip-text: _("Tab Overview");
        }

        [end]
        MenuButton {
          icon-name: "open-menu-symbolic";
          primary: true;
          tooltip-text: _("Main Menu");
          menu-model: primary_menu;
        }

        title-widget: Adw.WindowTitle {
          title: _("SQLator");
        };
      }

      [top]
      ScrolledWindow connection_tabs_scroll {
        visible: false;
        hexpand: true;
        vscrollbar-policy: never;
        hscrollbar-policy: automatic;
        overlay-scrolling: true;

        child: Box connection_tabs_box {
          orientation: horizontal;
          spacing: 4;
          margin-start: 8;
          margin-end: 8;
          margin-top: 4;
          margin-bottom: 4;
          styles [
            "connection-tab-bar",
          ]
        };
      }

      [top]
      Adw.TabBar tab_bar {
        view: tab_view;
        autohide: false;
      }

      content: Adw.OverlaySplitView split_view {
        show-sidebar: true;
        sidebar-width-fraction: 0.22;
        min-sidebar-width: 200;
        max-sidebar-width: 420;

        sidebar: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            show-end-title-buttons: false;

            [end]
            Button {
              action-name: "app.new-connection";
              icon-name: "list-add-symbolic";
              tooltip-text: _("New Connection");
            }

            title-widget: Adw.WindowTitle {
              title: _("Connections");
            };
          }

          content: Paned sidebar_paned {
            orientation: vertical;
            wide-handle: true;
            position: 280;
            shrink-start-child: false;
            shrink-end-child: false;

            [start]
            ScrolledWindow {
              hexpand: true;
              vexpand: true;

              child: ListView connection_list {
                styles [
                  "navigation-sidebar",
                ]
              };
            }

            [end]
            Box {
              orientation: vertical;
              hexpand: true;
              vexpand: true;

              Box {
                orientation: horizontal;
                margin-start: 8;
                margin-end: 4;
                margin-top: 6;
                margin-bottom: 4;

                Label {
                  label: _("Schema");
                  xalign: 0.0;
                  hexpand: true;
                  styles [
                    "heading",
                  ]
                }

                Button schema_refresh {
                  icon-name: "view-refresh-symbolic";
                  tooltip-text: _("Refresh schema");
                  styles [
                    "flat",
                  ]
                }
              }

              Label schema_banner {
                label: _("Connect to browse schema");
                xalign: 0.0;
                wrap: true;
                margin-start: 10;
                margin-end: 10;
                margin-bottom: 6;
                styles [
                  "dimmed",
                  "caption",
                ]
              }

              ScrolledWindow {
                hexpand: true;
                vexpand: true;

                child: ListView schema_list {
                  styles [
                    "navigation-sidebar",
                  ]
                };
              }
            }
          };
        };

        content: Stack content_stack {
          hexpand: true;
          vexpand: true;
          vhomogeneous: true;
          hhomogeneous: true;

          StackPage {
            name: "empty";
            child: Adw.StatusPage {
              icon-name: "network-server-symbolic";
              title: _("No connection open");
              description: _("Select a connection in the sidebar to open a query workspace.");
            };
          }

          StackPage {
            name: "tabs";
            child: Adw.TabView tab_view {
              hexpand: true;
              vexpand: true;
            };
          }
        };
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("New Tab");
      action: "win.new-tab";
    }

    item {
      label: _("Close Tab");
      action: "win.close-tab";
    }
  }

  section {
    submenu {
      label: _("Appearance");

      item {
        label: _("System");
        action: "app.color-scheme";
        target: "default";
      }

      item {
        label: _("Light");
        action: "app.color-scheme";
        target: "force-light";
      }

      item {
        label: _("Dark");
        action: "app.color-scheme";
        target: "force-dark";
      }
    }
  }

  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }
  }

  section {
    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}